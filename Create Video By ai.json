    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  try {\n    // 1. เข้าถึง Text จาก OpenAI\n    let rawText = item.json.output[0].content[0].text;\n    \n    // 2. Clean ขั้นต้น: ลบ Markdown และช่องว่างหัวท้าย\n    rawText = rawText.replace(/```json|```/g, \"\").trim();\n\n    // 3. 💥 แก้ไขจุดพัง: ลบ Bad Control Characters (เช่น \\n ที่เป็นตัวอักษรจริงๆ ไม่ใช่รหัส)\n    // โค้ดนี้จะช่วยล้างพวกตัวอักษรควบคุมที่ทำให้ JSON พัง\n    const sanitizedText = rawText.replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, \"\");\n\n    // 4. Parse เป็น JSON\n    const parsedData = JSON.parse(sanitizedText);\n    \n    const productName = item.json.product_name || \"สินค้า\";\n    const targetAudience = item.json.target_audience || \"ลูกค้า\";\n    \n    // 5. จัดการ Script และแทนที่ตัวแปร\n    const cleanScript = parsedData.script\n      .replace(/\\{\\{\\s?\\$json\\.product_name\\s?\\}\\}/g, productName)\n      .replace(/\\{\\{\\s?\\$json\\.target_audience\\s?\\}\\}/g, targetAudience);\n\n    return {\n      json: {\n        product_name: productName,\n        benefits: parsedData.benefits,\n        script: cleanScript\n      }\n    };\n  } catch (error) {\n    return { \n      json: {\n        error: \"JSON Sanitization Failed\", \n        message: error.message,\n        // ส่ง raw text ออกมาดูเพื่อหาว่าตำแหน่งที่ 86 คือตัวอะไร\n        debug_text: item.json.output[0].content[0].text\n      }\n    };\n  }\n});"
      },
